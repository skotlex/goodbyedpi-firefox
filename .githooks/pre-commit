#!/usr/bin/env node
'use strict';
// 커밋할 때마다 CHANGELOG 의 [Unreleased] 를 다음 버전으로 확정하고, 바뀐 버전 파일을 같은 커밋에 넣는다.
// src/ 를 고친 커밋은 버전이 반드시 올라가야 하므로 [Unreleased] 항목이 없으면 커밋을 막는다.

const { execFileSync } = require('child_process');
const fs   = require('fs');
const path = require('path');
const VERSION_FILES = require('../scripts/version-files');

const rootDir = path.join(__dirname, '..');
const git  = (...args) => execFileSync('git', args, { encoding: 'utf8', cwd: rootDir });
// -z: 한글 경로가 "\355..." 로 따옴표 처리되지 않게 한다
const list = (...args) => git(...args).split('\0').filter(Boolean);

function currentVersion() {
  return JSON.parse(fs.readFileSync(path.join(rootDir, 'package.json'), 'utf8')).version;
}

function headVersion() {
  try {
    const raw = execFileSync('git', ['show', 'HEAD:package.json'],
      { encoding: 'utf8', cwd: rootDir, stdio: ['ignore', 'pipe', 'ignore'] });
    return JSON.parse(raw).version;
  } catch {
    return '0.0.0';   // 첫 커밋
  }
}

function fail(message) {
  console.error(`\n[pre-commit] ${message}\n`);
  process.exit(1);
}

const staged    = list('diff', '--cached', '--name-only', '-z');
const srcStaged = staged.some(f => f.startsWith('src/'));

// 플러그인과 무관한 커밋(문서·스크립트 등)은 버전을 올리지 않는다
if (!srcStaged && !staged.includes('CHANGELOG.md')) process.exit(0);

// 버전 파일은 통째로 stage 되므로, 커밋하려던 게 아닌 편집이 끼어들 수 있으면 먼저 멈춘다
const unrelated = git('diff', '-U0', '--', ...VERSION_FILES).split(/\r?\n/)
  .filter(l => /^[-+]/.test(l) && !/^(---|\+\+\+)/.test(l) && !/"version"\s*:/.test(l));
if (unrelated.length) {
  fail(`버전 파일에 stage 하지 않은 수정이 있습니다. stage 하거나 되돌린 뒤 다시 커밋하세요: ${VERSION_FILES.join(', ')}`);
}

execFileSync(process.execPath, [path.join(rootDir, 'scripts', 'changelog-to-json.js'), '--release'], { stdio: 'inherit' });

const version = currentVersion();
if (version === headVersion()) {
  if (srcStaged) fail('src/ 를 수정했는데 CHANGELOG.md 의 [Unreleased] 에 항목이 없습니다. 항목을 추가한 뒤 다시 커밋하세요.');
  process.exit(0);
}

// 아직 추적하지 않는 파일(작업 중인 manifest 등)은 커밋에 끌어들이지 않는다
const tracked = list('ls-files', '-z', '--', 'CHANGELOG.md', ...VERSION_FILES);
if (tracked.length) git('add', '--', ...tracked);
console.log(`[pre-commit] ✓ 이 커밋의 버전: ${version}`);
