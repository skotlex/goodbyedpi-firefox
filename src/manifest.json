{
  "manifest_version": 3,
  "name": "GoodbyeDPI for Firefox",
  "version": "0.0.1",
  "description": "Firefox 트래픽만 내장된 ByeDPI 로 보내 DPI 차단을 우회합니다. 전체 적용, 특정 사이트만 적용, 특정 사이트만 제외를 고를 수 있습니다.",
  "browser_specific_settings": {
    "gecko": {
      "id": "goodbyedpi-firefox@skotlex",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "scripts": [
      "scope.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GoodbyeDPI for Firefox",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
